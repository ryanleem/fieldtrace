# Required for Docker/native setup. Choose your private local database password.
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
# Optional override for a custom/existing database; otherwise built from POSTGRES_PASSWORD.
# An explicit DATABASE_URL wins; keep its password synchronized if you set it.
# DATABASE_URL=postgresql+psycopg://guardian:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:55432/guardian
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
RRF_K=60
SEMANTIC_TOP_N=20
KEYWORD_TOP_N=20
HYBRID_TOP_K=10
EMBEDDING_BATCH_SIZE=32
# Step 3: set a funded key in your environment or private .env; never commit it.
OPENAI_API_KEY=
VISION_PROVIDER=openai
VISION_MODEL=gpt-4.1-mini-2025-04-14
# Alternative: set VISION_PROVIDER=gemini and provide a Google AI Studio key.
# VISION_MODEL stays OpenAI-only, so provider switching cannot reuse the wrong model.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
VISION_TIMEOUT_SECONDS=60
MAX_INSPECTION_IMAGES=30
MAX_INSPECTION_IMAGE_BYTES=10485760
MAX_INSPECTION_IMAGE_PIXELS=16000000
# UPLOADS_DIR defaults to the repository's data/uploads directory.
# Optional local paths: MANUALS_DIR, PROCESSED_DIR, MODEL_CACHE, UPLOADS_DIR.
# Optional CPU settings: EMBEDDING_DEVICE=cpu, EMBEDDING_THREADS=4.
# Step 4 text review/generation/verification uses OPENAI_API_KEY independently of VISION_PROVIDER.
TROUBLESHOOTING_MODEL=gpt-4.1-mini-2025-04-14
TROUBLESHOOTING_TIMEOUT_SECONDS=60
TROUBLESHOOTING_TOP_K=8
TROUBLESHOOTING_MAX_LLM_CALLS=48
