# Explicit read-only saved-response replay; never enabled automatically on API failure.
VITE_DEMO_MODE=false
# Vite server only. No API secrets belong in VITE_* variables.
BACKEND_URL=http://127.0.0.1:8000

# Public backend origin, no /api suffix for Railway. Empty preserves Vite /api proxy.
VITE_API_BASE_URL=
