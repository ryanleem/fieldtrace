# Explicit read-only saved-response replay; never enabled automatically on API failure.
VITE_DEMO_MODE=false
# Vite server only. No API secrets belong in VITE_* variables.
BACKEND_URL=http://127.0.0.1:8000

# Public backend origin, no /api suffix for Railway. Empty is LOCAL proxy only.
# Hosted live builds require all four VITE_* names in the target Vercel scope.
# Set Production and Preview separately; review branch-specific Preview overrides.
VITE_API_BASE_URL=

# Public Supabase project URL and publishable (or legacy anon) key ONLY.
# Never use a service-role/secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
